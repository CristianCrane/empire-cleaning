#!/bin/sh
#
# Before each commit, the staged code under packages/ gets the lint and the
# format check that CI's Checks job runs on every file (README.md), and every
# catalog the copies check, in a second or two. It reads the files as they
# are on disk. `pnpm install` sets it up; `git commit --no-verify` skips it.

set -e

files=$(git diff --cached --name-only --diff-filter=ACMR -- 'packages/*.ts' 'packages/*.tsx' 'packages/*.astro')

[ -z "$files" ] || pnpm exec oxlint --type-aware $files
# words-from-catalog over .astro markup, which oxlint can't see
[ -z "$files" ] || node packages/lint/src/astro-markup.ts $files
# the same English in two of the screens' catalogs: all of them, as a copy
# spans files
[ -z "$files" ] || node packages/lint/src/catalog-copies.ts
[ -z "$files" ] || pnpm exec prettier --check $files
