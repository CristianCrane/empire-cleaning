#!/bin/sh
#
# Before each commit, the staged code under packages/ gets the lint and the
# format check that CI's Checks job runs on every file (README.md), in a
# second or two. It reads the files as they are on disk. `pnpm install` sets
# it up; `git commit --no-verify` skips it.

set -e

files=$(git diff --cached --name-only --diff-filter=ACMR -- 'packages/*.ts' 'packages/*.tsx' 'packages/*.astro')

[ -z "$files" ] || pnpm exec oxlint --type-aware $files
[ -z "$files" ] || pnpm exec prettier --check $files
