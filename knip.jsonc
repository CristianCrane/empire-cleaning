{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      // run by Claude Code, from .claude/settings.json (copies made by ~/.claude/hooks/sync.mjs)
      "entry": [".claude/hooks/**/*.mjs"],
    },
    "packages/web": {
      // started inside playwright.config.ts's webServer command (bash -c),
      // where knip doesn't look
      "entry": ["e2e/preview.ts"],
    },
    "packages/server": {
      "entry": [
        // react-email's previews (`pnpm email:dev`)
        "emails/*.tsx",
        // the config `pnpm pr:shots` (tests/e2e/shots.ts) hands Playwright
        // by path
        "tests/e2e/shots.config.ts",
        // drizzle-kit reads every *.schema.ts (src/db/drizzle.config.ts), so
        // their tables and enums stay exported
        "src/db/drizzle.config.ts",
        "src/features/**/*.schema.ts",
      ],
      // read as entries above: loading the config would check the server's
      // environment variables
      "drizzle": false,
      // pino loads it by name, in development (src/services/monitoring/log.ts)
      "ignoreDependencies": ["pino-pretty"],
      // `pnpm pr:shots` runs the web app's or the landing site's own
      // Playwright, from that package's folder (tests/e2e/shots.ts)
      "ignoreBinaries": ["playwright"],
    },
  },
}
