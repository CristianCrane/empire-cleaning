{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    // knip's Playwright plugin would run each playwright.config.ts to read
    // it, and loading one leases a block of e2e ports (server's
    // tests/ports.ts): off, with the files it would find named here
    "packages/web": {
      "entry": [
        // started inside playwright.config.ts's webServer command (bash -c),
        // where knip doesn't look
        "e2e/preview.ts",
        "playwright.config.ts",
        "e2e/*.spec.ts",
        "e2e/*.sandbox.ts",
        // `pnpm pr:shots --prototype` alone runs it (shots.config.ts)
        "e2e/prototype.shots.ts",
      ],
      "playwright": false,
    },
    "packages/landing": {
      "entry": [
        "playwright.config.ts",
        "tests/*.spec.ts",
        // `pnpm pr:shots --prototype` alone runs it (shots.config.ts)
        "tests/prototype.shots.ts",
      ],
      "playwright": false,
    },
    "packages/server": {
      "entry": [
        // react-email's previews (`pnpm email:dev`)
        "emails/*.tsx",
        // the config `pnpm pr:shots` (tests/e2e/shots.ts) hands Playwright
        // by path
        "tests/e2e/shots.config.ts",
      ],
      // drizzle-kit's config isn't at the plugin's default path
      // (package.json's db:* scripts); its schema files stay entries
      "drizzle": { "config": "src/db/drizzle.config.ts" },
      // pino loads it by name, in development (src/services/monitoring/log.ts)
      "ignoreDependencies": ["pino-pretty"],
    },
  },
}
