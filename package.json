{
  "name": "empire-cleaning",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --color --recursive --parallel run dev",
    "build": "pnpm --color --recursive run build",
    "test": "pnpm --color --recursive --workspace-concurrency=1 --no-bail run test:quick",
    "check": "pnpm --color --recursive run check",
    "check:packages": "manypkg check",
    "lint": "prettier --write \"packages/*/{src,tests,.storybook}/**/*.{ts,tsx}\"",
    "lint:check": "prettier --check \"packages/*/{src,tests,.storybook}/**/*.{ts,tsx}\"",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "pnpm --filter @empire-cleaning/server db:generate",
    "db:migrate": "pnpm --filter @empire-cleaning/server db:migrate",
    "db:push": "pnpm --filter @empire-cleaning/server db:push",
    "db:studio": "pnpm --filter @empire-cleaning/server db:studio",
    "db:seed": "pnpm --filter @empire-cleaning/server db:seed",
    "test:full": "pnpm --color --recursive --workspace-concurrency=1 --no-bail run test",
    "email:dev": "pnpm --filter @empire-cleaning/server email:dev"
  },
  "devDependencies": {
    "@manypkg/cli": "^0.25.1",
    "prettier": "^3.9.6",
    "syncpack": "^15.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
