# copy to .env (never committed) and fill in; the server checks the same
# variables in dev and prod (src/env.ts)
APP_MODE=dev
PORT=3000
CORS_ORIGIN_URL=http://localhost:5173
LANDING_ORIGIN_URL=http://localhost:4321
DB_URL=postgresql://postgres:password@localhost:5432/empire_dev

# Resend API key (resend.com, API Keys)
RESEND_API_KEY=
EMAIL_FROM="Empire Cleaning <no-reply@empirecleaningandpro.com>"

# public URL of this API; sign-in links point here
BETTER_AUTH_URL=http://localhost:3000
# at least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google Cloud console, OAuth client; redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe dashboard, Developers > API keys (test-mode keys in dev)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
