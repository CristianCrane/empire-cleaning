{
  "name": "@empire-cleaning/server",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "node src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@empire-cleaning/models": "workspace:*",
    "custom-env": "^2.0.6",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.13"
  }
}
