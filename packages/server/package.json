{
  "name": "@empire-cleaning/server",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#middleware": "./src/middleware/index.ts",
    "#db": "./src/db/index.ts",
    "#features/*": "./src/features/*/index.ts",
    "#services/*": "./src/services/*/index.ts"
  },
  "exports": {
    "./checkout": "./tests/checkout.ts"
  },
  "scripts": {
    "dev": "nodemon --watch src -e ts,tsx --exec \"tsx --env-file=.env src/index.ts\"",
    "start": "tsx --import ./src/instrument.ts src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config=./src/db/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=./src/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=./src/db/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=./src/db/drizzle.config.ts",
    "db:seed": "tsx --env-file-if-exists=.env ./tests/seed.ts",
    "test": "vitest run",
    "test:seed": "vitest run --project seed",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "staff:testers": "tsx --env-file-if-exists=.env ./tests/testers.ts",
    "auth:create-owner": "tsx --env-file=.env ./src/features/auth/create-owner.ts",
    "e2e:server": "tsx tests/e2e/server.ts",
    "stripe:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "stripe:record": "tsx --env-file=.env tests/contract/record-stripe.ts",
    "test:quick": "vitest run --project server",
    "email:dev": "email dev --dir emails --port 3002"
  },
  "dependencies": {
    "@empire-cleaning/models": "workspace:*",
    "@sentry/node": "^11.10.0",
    "better-auth": "^1.7.7",
    "cors": "^2.8.6",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.3.0",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "6.11.3",
    "resend": "^6.34.1",
    "stripe": "^23.0.1",
    "tsx": "^4.23.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "1.0.0-rc.4",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1"
  }
}
