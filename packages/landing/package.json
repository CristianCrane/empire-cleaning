{
  "name": "@empire-cleaning/landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --port 4321",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check --minimumFailingSeverity hint",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --port 4321",
    "test": "playwright test",
    "test:install-browser": "playwright install chromium",
    "test:quick": "playwright test --project phone --grep @smoke"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@empire-cleaning/browser-monitoring": "workspace:*",
    "@empire-cleaning/models": "workspace:*",
    "@empire-cleaning/quote-request": "workspace:*",
    "@empire-cleaning/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.7",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "16.35.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.13.0",
    "@empire-cleaning/server": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "npm:typescript@^6.0.3",
    "vite": "^8.3.4"
  }
}
