---
import AreaAndTrust from "../components/AreaAndTrust.astro";
import Faqs from "../components/Faqs.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HowItWorks from "../components/HowItWorks.astro";
import RequestQuote from "../components/RequestQuote.astro";
import Reviews from "../components/Reviews.astro";
import ServicePlans from "../components/ServicePlans.astro";
import Services from "../components/Services.astro";
import { faqs } from "../faqs.ts";
import Page from "../layouts/Page.astro";
---

<Page>
  <Header />
  <main>
    <Hero />
    <Services />
    <Reviews />
    <AreaAndTrust />
    {/* the steps sit just above the form where they start */}
    <HowItWorks />
    <RequestQuote />
    <ServicePlans />
    {/* after the form, for whoever still has a question; folded, so the
        page stays quiet (#180) */}
    <Faqs faqs={faqs} />
  </main>
  <Footer />
</Page>
