---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { PrototypeBar, PrototypeIndex } from "@empire-cleaning/ui";
import Page from "../layouts/Page.astro";
import { landingHome } from "@empire-cleaning/models";
import { shotPath, type Prototype } from "../prototype.ts";

// every prototype's pages, on a prototype-* branch (src/prototype.ts): main
// has none, so this makes no page there
export const getStaticPaths = () => {
  const lists = import.meta.glob<{ default: Prototype }>("../prototypes/*.ts", {
    eager: true,
  });
  return Object.entries(lists).flatMap(([file, { default: drawn }]) => {
    const screen = file.replace(/^.*\/|\.ts$/g, "");
    const index = {
      params: { prototype: `prototype/${screen}` },
      props: { screen, drawn },
    };
    const shots = Object.entries(drawn.cases).flatMap(([shown, { lang }]) =>
      drawn.layouts.map(({ key: layout }) => ({
        params: {
          prototype: shotPath(screen, layout, shown, lang).slice(1, -1),
        },
        props: { screen, drawn, layout, shown },
      })),
    );
    return [index, ...shots];
  });
};

type Props = {
  screen: string;
  drawn: Prototype;
  layout?: string;
  shown?: string;
};
const { screen, drawn, layout, shown } = Astro.props;
const views = import.meta.glob<{ default: AstroComponentFactory }>(
  "../prototypes/*.astro",
  { eager: true },
);
const View = views[`../prototypes/${screen}.astro`]?.default;
const hrefOf = (to: string, at: string) =>
  shotPath(screen, to, at, drawn.cases[at]?.lang);
---

<Page page={null} title={screen}>
  {layout && shown && View ? (
    <>
      {/* the shots wait for it (prototype-shots.ts) */}
      <div data-prototype-case class="contents">
        <View layout={layout} case={shown} />
      </div>
      {import.meta.env.DEV && (
        <PrototypeBar
          client:only="react"
          layouts={drawn.layouts.map(({ key, name }) => ({
            key,
            name,
            href: hrefOf(key, shown),
          }))}
          cases={Object.entries(drawn.cases).map(([key, { name }]) => ({
            key,
            name,
            href: hrefOf(layout, key),
          }))}
          layout={layout}
          case={shown}
          index={`${landingHome.en}prototype/${screen}/`}
        />
      )}
    </>
  ) : (
    <PrototypeIndex
      screen={screen}
      layouts={drawn.layouts}
      cases={Object.entries(drawn.cases).map(([key, { name }]) => ({
        key,
        name,
      }))}
      hrefOf={hrefOf}
    />
  )}
</Page>
