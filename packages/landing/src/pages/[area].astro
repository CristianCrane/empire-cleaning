---
import { areas, type Area } from "../areas/index.ts";
import PageHero from "../components/PageHero.astro";
import Faqs from "../components/Faqs.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import HowItWorks from "../components/HowItWorks.astro";
import RequestQuote from "../components/RequestQuote.astro";
import Reviews from "../components/Reviews.astro";
import Section from "../components/Section.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { areaData } from "../structured-data.ts";
import Page from "../layouts/Page.astro";

// a page per area we serve (#176), in the home page's bands (prototype
// "Bands"); its words are the area's own, in src/areas. The footer links
// to the other areas
export function getStaticPaths() {
  return areas.map((area) => ({ params: { area: area.slug }, props: { area } }));
}
const { area } = Astro.props as { area: Area };
---

<Page
  title={area.title}
  description={area.description}
  path={`${area.slug}/`}
  data={areaData(area)}
>
  <Header />
  <main>
    <PageHero crumb={area.name} heading={area.heading} intro={area.intro} />
    <Section id="places" title={area.places.title} tone="raised">
      <ul class="flex flex-wrap justify-center gap-2">
        {area.places.list.map((p) => (
          <li class="rounded-full border border-border bg-bg px-4 py-1.5">{p}</li>
        ))}
      </ul>
      {area.places.note && <p class="text-center text-fg-muted">{area.places.note}</p>}
    </Section>
    <Section id="homes" title={area.homes.title}>
      <div class="mx-auto flex max-w-2xl flex-col gap-4 text-lg">
        {area.homes.text.map((t) => <p>{t}</p>)}
      </div>
    </Section>
    <Section id="popular" title={area.popular.title}>
      {/* the home page's service cards, two across, in the area's words */}
      <ul class="grid gap-4 sm:grid-cols-2">
        {area.popular.list.map(({ service, text }) => (
          <ServiceCard name={service} text={text} on="plain" />
        ))}
      </ul>
    </Section>
    <Reviews />
    <Faqs faqs={area.faqs} />
    <HowItWorks />
    <RequestQuote />
  </main>
  <Footer />
</Page>
