---
import { buttonStyles } from "@empire-cleaning/ui";
import { Phone } from "lucide-react";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { business } from "../business.ts";
import Page from "../layouts/Page.astro";
---

<!-- an address that isn't a page (#172): served for any unknown path, with a
     404 status, and left out of the sitemap. Back to the home page, its
     Quote form or the phone; the footer carries the logo -->
<Page title="Page not found" path={null}>
  <Header />
  <main class="mx-auto flex max-w-xl flex-col items-center gap-6 px-4 pt-16 pb-24 text-center">
    <h1 class="font-display text-4xl font-bold tracking-wide uppercase sm:text-5xl">
      Page not found
    </h1>
    <p class="text-xl text-fg-muted">
      There's no page at this address. Request a Quote or give us a call, and
      we'll take it from there.
    </p>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a href="/#quote" class={buttonStyles({ variant: "primary", className: "px-6 text-lg" })}>
        Request a Quote
      </a>
      <a href={business.phone.href} class={buttonStyles({ variant: "secondary", className: "px-6 text-lg" })}>
        <Phone aria-hidden size={20} />
        Call {business.phone.display}
      </a>
    </div>
  </main>
  <Footer />
</Page>
