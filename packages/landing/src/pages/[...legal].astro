---
import { formats, languageOf, legalPages } from "@empire-cleaning/models";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import Prose from "../components/Prose.astro";
import Section from "../components/Section.astro";
import { legalOf } from "../legal/index.ts";
import Page from "../layouts/Page.astro";
import { routesOf } from "../routes.ts";
import { legalData } from "../structured-data.ts";
import { words } from "../words.ts";

// a policy (#462), the Privacy policy or the Terms of service, at its
// address in each language (src/routes.ts): its name and the day it took
// effect, then a band per part, read down one narrow column as a guide is.
// Nothing to sell: no form, and no Request a Quote at the top
export const getStaticPaths = () => routesOf("legal");
const { page } = Astro.props;
const lang = languageOf(Astro.currentLocale);
const policy = legalOf(page.legal)[lang];
const { name } = legalPages[lang][page.legal];
const effective = words[lang].effective(
  formats[lang].formatFullDay(policy.effective),
);
---

<Page
  title={name}
  description={policy.description}
  page={page}
  data={legalData(page.legal, lang)}
>
  <Header page={page} />
  <main>
    <PageHero crumb={name} heading={name} intro={effective} actions={false} />
    {policy.sections.map(({ title, text, list }, i) => (
      <Section id={`part-${i + 1}`} title={title}>
        <Prose text={text} list={list} />
      </Section>
    ))}
  </main>
  <Footer />
</Page>
