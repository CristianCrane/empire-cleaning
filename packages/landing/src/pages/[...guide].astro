---
import { languageOf } from "@empire-cleaning/models";
import { Check } from "lucide-react";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PageHero from "../components/PageHero.astro";
import RequestQuote from "../components/RequestQuote.astro";
import Section from "../components/Section.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { guideOf } from "../guides/index.ts";
import Page from "../layouts/Page.astro";
import { routesOf } from "../routes.ts";
import { guideData } from "../structured-data.ts";
import { words } from "../words.ts";

// a guide (#180), at its address in each language (src/routes.ts): the
// page's hero, then a band per part, read like an article down one narrow
// column; the form; and the services it's linked from
export const getStaticPaths = () => routesOf("guide");
const { page } = Astro.props;
const lang = languageOf(Astro.currentLocale);
const guide = guideOf(page.guide)[lang];
const related = [...new Set(guide.linkedFrom.map((l) => l.service))].slice(
  0,
  3,
);
const sectionId = (i: number) => `part-${i + 1}`;
---

<Page
  title={guide.title}
  description={guide.description}
  page={page}
  data={guideData(guide, lang)}
>
  <Header page={page} />
  <main>
    <PageHero crumb={guide.crumb} heading={guide.heading} intro={guide.intro} />
    {guide.sections.map(({ title, text, list }, i) => (
      <Section id={sectionId(i)} title={title}>
        <div class="mx-auto flex max-w-2xl flex-col gap-4 text-lg">
          {text.map((t) => (
            <p>{t}</p>
          ))}
          {list && (
            <ul class="flex flex-col gap-3">
              {list.map((item) => (
                <li class="flex items-start gap-2">
                  <Check
                    aria-hidden
                    size={20}
                    className="mt-1 shrink-0 text-primary"
                  />
                  {item}
                </li>
              ))}
            </ul>
          )}
        </div>
      </Section>
    ))}
    <RequestQuote />
    <Section id="related" title={words[lang].ourServices}>
      <ul class="grid gap-4 sm:grid-cols-3">
        {related.map((service) => (
          <ServiceCard service={service} />
        ))}
      </ul>
    </Section>
  </main>
  <Footer />
</Page>
