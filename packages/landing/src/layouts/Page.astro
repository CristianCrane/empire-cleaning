---
import "@empire-cleaning/ui/tokens.css";
import { themeBootScript } from "@empire-cleaning/ui/theme-boot";
import { firstScreenFonts } from "@empire-cleaning/ui/fonts";
import { TestSiteBanner } from "@empire-cleaning/ui";
import { business } from "../business.ts";
import { isTestSite } from "../site-mode.ts";
import { structuredData } from "../structured-data.ts";

// a page other than the home page names itself first; only the home page is
// canonical, and the 404 isn't any page's address
type Props = { title?: string; canonical?: boolean };
const { title, canonical = true } = Astro.props;
const pageTitle = title ? `${title} | ${business.brand}` : business.title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeBootScript} />
    {/* the first screen's fonts, fetched with the page so its text doesn't
        reflow when they arrive */}
    {
      firstScreenFonts.map((href) => (
        <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
      ))
    }
    <title>{pageTitle}</title>
    <meta name="description" content={business.description} />
    {canonical && <link rel="canonical" href={business.url} />}
    <meta name="theme-color" content="#06682f" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {isTestSite && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={business.description} />
    <meta property="og:url" content={business.url} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL("og-image.png", business.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={business.brand} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    {isTestSite && <TestSiteBanner />}
    <slot />
  </body>
</html>
