---
import "@empire-cleaning/ui/tokens.css";
import { themeBootScript } from "@empire-cleaning/ui/theme-boot";
import { firstScreenFonts } from "@empire-cleaning/ui/fonts";
import { LANGUAGES, languageOf } from "@empire-cleaning/models";
import { LanguageProvider, TestSiteBanner } from "@empire-cleaning/ui";
import { business, businessWords } from "../business.ts";
import { urlOf, type Page } from "../routes.ts";
import { isTestSite } from "../site-mode.ts";
import { structuredData } from "../structured-data.ts";

// a page other than the home page names itself first; every page says which
// it is, for its address and its twin's in the other language; the 404
// isn't any page's address (null). Its own structured data joins the
// business's. Its language is its address's (Astro.currentLocale)
type Props = {
  title?: string;
  description?: string;
  page: Page | null;
  data?: object[];
};
const lang = languageOf(Astro.currentLocale);
const {
  title,
  description = businessWords[lang].description,
  page,
  data,
} = Astro.props;
const pageTitle = title
  ? `${title} | Empire Cleaning`
  : businessWords[lang].title;
const urlIn = (l: typeof lang) => page && urlOf(page, l);
const url = urlIn(lang);
// Open Graph's way of naming a language
const ogLocale = { en: "en_US", es: "es_US" };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeBootScript} />
    {/* the first screen's fonts, fetched with the page so its text doesn't
        reflow when they arrive */}
    {firstScreenFonts.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
    ))}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {url && <link rel="canonical" href={url} />}
    {/* the page in each language, and English for any other (ADR-0025) */}
    {page &&
      LANGUAGES.map((l) => (
        <link rel="alternate" hreflang={l} href={urlIn(l)} />
      ))}
    {page && <link rel="alternate" hreflang="x-default" href={urlIn("en")} />}
    <meta name="theme-color" content="#06682f" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {isTestSite && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.brand} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {url && <meta property="og:url" content={url} />}
    <meta property="og:locale" content={ogLocale[lang]} />
    {LANGUAGES.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={ogLocale[l]} />
    ))}
    <meta
      property="og:image"
      content={new URL("og-image.png", business.url).href}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={business.brand} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData(lang, data))}
    />
  </head>
  <body>
    {isTestSite && (
      <LanguageProvider lang={lang}>
        <TestSiteBanner />
      </LanguageProvider>
    )}
    <slot />
  </body>
</html>

<script>
  // Sentry, and the test site's feedback button (src/monitoring.ts)
  import { startLandingMonitoring } from "../monitoring.ts";
  startLandingMonitoring();
</script>
