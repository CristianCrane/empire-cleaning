---
import "@empire-cleaning/ui/tokens.css";
import { themeBootScript } from "@empire-cleaning/ui/theme-boot";
import { TestSiteBanner } from "@empire-cleaning/ui";
import { business } from "../business.ts";
import { isTestSite } from "../site-mode.ts";

// structured data so search engines can show the business (name, phone, area)
const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: business.name,
  url: business.url,
  telephone: business.phone.e164,
  description: business.description,
  areaServed: { "@type": "AdministrativeArea", name: "Queens, New York" },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeBootScript} />
    <title>{business.title}</title>
    <meta name="description" content={business.description} />
    <link rel="canonical" href={business.url} />
    <meta name="theme-color" content="#06682f" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {isTestSite && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:title" content={business.title} />
    <meta property="og:description" content={business.description} />
    <meta property="og:url" content={business.url} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={new URL("og-image.png", business.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={business.name} />
    <meta name="twitter:card" content="summary_large_image" />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(localBusiness)}
    />
  </head>
  <body>
    {isTestSite && <TestSiteBanner />}
    <slot />
  </body>
</html>
