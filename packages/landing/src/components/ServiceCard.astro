---
import { languageOf } from "@empire-cleaning/models";
import { ChevronRight } from "lucide-react";
import { card } from "../band.ts";
import { pathOf } from "../routes.ts";
import { pageOf } from "../service-pages/index.ts";
import { serviceWords, services, type ServiceKey } from "../services.ts";

// one of the home page's service cards, wherever it shows. The whole card
// leads to its service's page (#177), where it has one; its name says so, in
// the brand colour with an arrow. Its colour stands out from its band
interface Props {
  service: ServiceKey;
  // the card's own words, if not the home page's
  text?: string;
}
const { service, text } = Astro.props;
const lang = languageOf(Astro.currentLocale);
const { name, text: usual } = serviceWords[lang][service];
const Icon = services.find((s) => s.key === service)!.icon;
const href = pageOf(service) && pathOf({ kind: "service", service }, lang);
---

<li
  class:list={[
    "relative flex flex-col gap-3 rounded-lg border border-border p-5",
    card,
    href &&
      "has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-focus hover:border-primary",
  ]}
>
  <span class="flex size-12 items-center justify-center rounded-full bg-success-subtle text-success-strong">
    <Icon aria-hidden size={24} />
  </span>
  <h3 class="text-lg font-semibold">
    {href ? (
      <a
        href={href}
        class="inline-flex items-center gap-1 text-primary outline-none after:absolute after:inset-0"
      >
        {name}
        <ChevronRight aria-hidden size={18} />
      </a>
    ) : (
      name
    )}
  </h3>
  <p class="text-fg-muted">{text ?? usual}</p>
</li>
