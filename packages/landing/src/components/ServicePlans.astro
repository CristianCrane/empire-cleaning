---
import { languageOf } from "@empire-cleaning/models";
import { BadgePercent } from "lucide-react";
import { words } from "../words.ts";
import Section from "./Section.astro";

const t = words[languageOf(Astro.currentLocale)].plans;
---

<Section id="service-plans" title={t.title}>
  <div class="flex flex-col gap-6 rounded-lg bg-primary p-6 text-primary-fg sm:flex-row sm:items-center sm:p-8">
    <BadgePercent aria-hidden size={56} className="shrink-0" />
    <div class="flex flex-col gap-2">
      <p class="text-xl font-semibold">{t.lead}</p>
      <p class="text-lg">{t.text}</p>
    </div>
  </div>
</Section>
