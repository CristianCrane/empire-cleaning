---
// prototype (#176): an area's page, three ways
import { Logo, buttonStyles } from "@empire-cleaning/ui";
import { ChevronDown, ChevronRight, MapPin, Phone } from "lucide-react";
import { areas, type Area } from "../areas/index.ts";
import { business } from "../business.ts";
import { services } from "../services.ts";
import HowItWorks from "./HowItWorks.astro";
import RequestQuote from "./RequestQuote.astro";
import Reviews from "./Reviews.astro";
import Section from "./Section.astro";

interface Props {
  area: Area;
  layout: "bands" | "article" | "beside";
}
const { area, layout } = Astro.props;
const others = areas.filter((a) => a.slug !== area.slug);
const iconOf = (name: string) =>
  services.find((s) => s.name === name)?.icon ?? MapPin;
---

{/* the top: the logo home, the breadcrumbs, what and where, the two actions */}
<section aria-labelledby="area-title" class="pt-4 pb-14 sm:pb-20">
  <div
    class:list={[
      "mx-auto flex flex-col gap-6 px-4",
      layout === "bands" ? "max-w-5xl items-center text-center" : "max-w-5xl",
    ]}
  >
    <a href="/" aria-label={`${business.brand} home`}>
      <Logo className="w-32 sm:w-36" />
    </a>
    <nav aria-label="Breadcrumbs">
      <ol class="flex items-center gap-1 text-fg-muted">
        <li><a href="/" class="font-semibold text-primary">Home</a></li>
        <li aria-hidden="true"><ChevronRight size={16} /></li>
        <li aria-current="page">{area.name}</li>
      </ol>
    </nav>
    <h1
      id="area-title"
      class="max-w-3xl font-display text-4xl leading-tight font-bold tracking-wide uppercase sm:text-5xl"
    >
      {area.heading}
    </h1>
    <p class="max-w-2xl text-xl text-fg-muted">{area.intro}</p>
    <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
      <a href="#quote" class={buttonStyles({ variant: "primary", className: "px-6 text-lg" })}>
        Request a Quote
      </a>
      <a href={business.phone.href} class={buttonStyles({ variant: "secondary", className: "px-6 text-lg" })}>
        <Phone aria-hidden size={20} />
        Call {business.phone.display}
      </a>
    </div>
  </div>
</section>

{
  layout === "bands" && (
    <>
      <Section id="places" title={area.places.title} tone="raised">
        <ul class="flex flex-wrap justify-center gap-2">
          {area.places.list.map((p) => (
            <li class="rounded-full border border-border bg-bg px-4 py-1.5">{p}</li>
          ))}
        </ul>
        {area.places.note && <p class="text-center text-fg-muted">{area.places.note}</p>}
      </Section>
      <Section id="homes" title={area.homes.title}>
        <div class="mx-auto flex max-w-2xl flex-col gap-4 text-lg">
          {area.homes.text.map((t) => <p>{t}</p>)}
        </div>
      </Section>
      <Section id="popular" title={area.popular.title} tone="raised">
        <ul class="grid gap-4 sm:grid-cols-2">
          {area.popular.list.map(({ service, text }) => {
            const Icon = iconOf(service);
            return (
              <li class="flex flex-col gap-3 rounded-lg border border-border bg-bg p-5">
                <span class="flex size-12 items-center justify-center rounded-full bg-success-subtle text-success-strong">
                  <Icon aria-hidden size={24} />
                </span>
                <h3 class="text-lg font-semibold">{service}</h3>
                <p class="text-fg-muted">{text}</p>
              </li>
            );
          })}
        </ul>
      </Section>
      <Reviews />
      <Section id="faqs" title="Questions we're asked">
        <div class="mx-auto flex w-full max-w-2xl flex-col divide-y divide-border border-y border-border">
          {area.faqs.map(({ question, answer }) => (
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-semibold">
                {question}
                <ChevronDown aria-hidden size={20} className="shrink-0 transition group-open:rotate-180" />
              </summary>
              <p class="pt-3 text-fg-muted">{answer}</p>
            </details>
          ))}
        </div>
      </Section>
      <HowItWorks />
      <RequestQuote />
    </>
  )
}

{
  layout !== "bands" && (
    <div
      class:list={[
        "mx-auto max-w-5xl px-4 pb-14",
        layout === "beside" && "lg:grid lg:grid-cols-[1fr_26rem] lg:gap-12",
      ]}
    >
      <article class="flex max-w-2xl flex-col gap-12 text-lg">
        <section class="flex flex-col gap-4">
          <h2 class="font-display text-3xl font-bold tracking-wide uppercase">{area.places.title}</h2>
          <p>
            {area.places.list.join(", ")}. {area.places.note}
          </p>
        </section>
        <section class="flex flex-col gap-4">
          <h2 class="font-display text-3xl font-bold tracking-wide uppercase">{area.homes.title}</h2>
          {area.homes.text.map((t) => <p>{t}</p>)}
        </section>
        <section class="flex flex-col gap-4">
          <h2 class="font-display text-3xl font-bold tracking-wide uppercase">{area.popular.title}</h2>
          <dl class="flex flex-col gap-4">
            {area.popular.list.map(({ service, text }) => (
              <div>
                <dt class="font-semibold">{service}</dt>
                <dd class="text-fg-muted">{text}</dd>
              </div>
            ))}
          </dl>
        </section>
        <section class="flex flex-col gap-4">
          <h2 class="font-display text-3xl font-bold tracking-wide uppercase">Questions we're asked</h2>
          {area.faqs.map(({ question, answer }) => (
            <div>
              <h3 class="font-semibold">{question}</h3>
              <p class="text-fg-muted">{answer}</p>
            </div>
          ))}
        </section>
      </article>
      {layout === "beside" && (
        <aside class="hidden lg:block">
          <div class="sticky top-4 flex flex-col gap-4 rounded-lg border border-border bg-surface p-6">
            <h2 class="text-xl font-semibold">Request a Quote</h2>
            <p class="text-fg-muted">
              Tell us about your home and we'll email you a Quote, usually within a working day.
            </p>
            <a href="#quote" class={buttonStyles({ variant: "secondary" })}>Start your Quote</a>
            <a href={business.phone.href} class="font-semibold">Or call {business.phone.display}</a>
          </div>
        </aside>
      )}
    </div>
  )
}
{layout !== "bands" && <RequestQuote />}

{/* every layout: the other areas, then (in the footer) all of them */}
<Section id="other-areas" title="Other areas we serve">
  <ul class="flex flex-wrap justify-center gap-3">
    {
      others.map((a) => (
        <li>
          <a href={`/prototype/area/${layout}/${a.slug}/`} class={buttonStyles({ variant: "text" })}>
            <MapPin aria-hidden size={18} />
            {a.name}
          </a>
        </li>
      ))
    }
  </ul>
</Section>
