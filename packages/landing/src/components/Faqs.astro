---
import { languageOf } from "@empire-cleaning/models";
import { ChevronDown } from "lucide-react";
import type { Faq } from "../faqs.ts";
import { pathOf } from "../routes.ts";
import { words } from "../words.ts";
import Section from "./Section.astro";

// an answer can end with a link to more (a guide)
interface Props {
  faqs: Faq[];
}
const { faqs } = Astro.props;
const lang = languageOf(Astro.currentLocale);
---

<Section id="faqs" title={words[lang].faqs}>
  {/* each question opens its answer, without JavaScript; every answer is in
      the page for search engines */}
  <div class="mx-auto flex w-full max-w-2xl flex-col divide-y divide-border border-y border-border">
    {faqs.map(({ question, answer, more }) => (
      <details class="group py-4">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-sm text-lg font-semibold outline-offset-4 outline-focus focus-visible:outline-2 [&::-webkit-details-marker]:hidden">
          {question}
          <ChevronDown
            aria-hidden
            size={20}
            className="shrink-0 transition group-open:rotate-180"
          />
        </summary>
        <p class="pt-3 text-fg-muted">
          {answer}
          {more && (
            <>
              {" "}
              <a
                href={pathOf(more.page, lang)}
                class="font-semibold text-primary"
              >
                {more.text}
              </a>
            </>
          )}
        </p>
      </details>
    ))}
  </div>
</Section>
