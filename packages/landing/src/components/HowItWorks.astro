---
import { messages } from "@empire-cleaning/models";
import Section from "./Section.astro";

const { REQUEST_A_QUOTE } = messages.en;

const steps = [
  {
    name: REQUEST_A_QUOTE,
    text: "Tell us about your place in a few minutes. No account or sign-up needed.",
  },
  {
    name: "Get your quote",
    text: "We email you a price. We recommend a deep clean first, or choose a lighter standard clean if you prefer.",
  },
  {
    name: "Book with a deposit",
    text: "Accept online and pay a deposit to secure your date. The rest is charged once the clean is done.",
  },
];
---

<Section id="how-it-works" title="How it works">
  {/* each step centred: one under another on a phone, three across from a tablet */}
  <ol class="grid gap-6 sm:grid-cols-3">
    {steps.map(({ name, text }, i) => (
      <li class="flex flex-col items-center gap-3 text-center">
        <span
          aria-hidden="true"
          class="flex size-12 items-center justify-center rounded-full bg-primary font-display text-2xl font-bold text-primary-fg"
        >
          {i + 1}
        </span>
        <h3 class="text-lg font-semibold">{name}</h3>
        <p class="text-fg-muted">{text}</p>
      </li>
    ))}
  </ol>
</Section>
