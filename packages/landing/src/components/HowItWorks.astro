---
import { languageOf, messages } from "@empire-cleaning/models";
import { words } from "../words.ts";
import Section from "./Section.astro";

const lang = languageOf(Astro.currentLocale);
const { title, steps: texts, names } = words[lang].howItWorks;
// the first step is the Request a quote button's
const steps = [messages[lang].REQUEST_A_QUOTE, ...names].map((name, i) => ({
  name,
  text: texts[i]!,
}));
---

<Section id="how-it-works" title={title}>
  {/* each step centred: one under another on a phone, three across from a tablet */}
  <ol class="grid gap-6 sm:grid-cols-3">
    {steps.map(({ name, text }, i) => (
      <li class="flex flex-col items-center gap-3 text-center">
        <span
          aria-hidden="true"
          class="flex size-12 items-center justify-center rounded-full bg-primary font-display text-2xl font-bold text-primary-fg"
        >
          {i + 1}
        </span>
        <h3 class="text-lg font-semibold">{name}</h3>
        <p class="text-fg-muted">{text}</p>
      </li>
    ))}
  </ol>
</Section>
