---
import { type Catalog, formats, languageOf } from "@empire-cleaning/models";
import { Gem, MapPin, ShieldCheck, Users } from "lucide-react";
import { areas, type Area } from "../areas/index.ts";
import { card } from "../band.ts";
import { businessWords } from "../business.ts";
import { pathOf } from "../routes.ts";
import { words } from "../words.ts";
import Section from "./Section.astro";

const lang = languageOf(Astro.currentLocale);
const t = words[lang].why;
const icons = [ShieldCheck, Gem, Users];

// the areas, in a sentence: "Queens, Brooklyn, Manhattan, Nassau and
// western Suffolk", each a link to its page (#176)
const areaList = formats[lang]
  .listParts(areas.map((_, i) => String(i)))
  .map(({ type, value }): { text: string } | { area: Catalog<Area> } =>
    type === "literal" ? { text: value } : { area: areas[Number(value)]! },
  );
---

<Section id="why-empire" title={t.title}>
  {/* the icon beside the words, or above them in four narrow columns; the
      area first, then what we promise, each a card of its own, alike */}
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <li
      class:list={[
        "flex items-start gap-4 rounded-lg border border-border p-5 lg:flex-col lg:gap-3",
        card,
      ]}
    >
      <MapPin aria-hidden size={28} className="shrink-0 text-primary" />
      <div class="flex flex-col gap-1">
        <h3 class="text-lg font-semibold">
          {t.serving(businessWords[lang].area)}
        </h3>
        <p class="text-fg-muted">
          {areaList.map((part) =>
            "area" in part ? (
              <a
                href={pathOf({ kind: "area", area: part.area }, lang)}
                class="font-semibold text-primary"
              >
                {part.area[lang].short}
              </a>
            ) : (
              part.text
            ),
          )}
          {"."}
          {/* the crew speaks Spanish, said in Spanish on an English page */}
          {t.spanish && <span lang="es"> {t.spanish}</span>}
        </p>
      </div>
    </li>
    {t.points.map(({ name, text }, i) => {
      const Icon = icons[i]!;
      return (
        <li
          class:list={[
            "flex items-start gap-4 rounded-lg border border-border p-5 lg:flex-col lg:gap-3",
            card,
          ]}
        >
          <Icon aria-hidden size={28} className="shrink-0 text-primary" />
          <div class="flex flex-col gap-1">
            <h3 class="text-lg font-semibold">{name}</h3>
            <p class="text-fg-muted">{text}</p>
          </div>
        </li>
      );
    })}
  </ul>
</Section>
