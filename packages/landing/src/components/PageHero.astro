---
import { Logo } from "@empire-cleaning/ui";
import { languageOf } from "@empire-cleaning/models";
import { ChevronRight } from "lucide-react";
import { business } from "../business.ts";
import { pathOf } from "../routes.ts";
import { words } from "../words.ts";
import QuoteOrCall from "./QuoteOrCall.astro";

// the top of an area's or a service's page: `crumb` names it after Home
interface Props {
  crumb: string;
  heading: string;
  intro: string;
}
const { crumb, heading, intro } = Astro.props;
const lang = languageOf(Astro.currentLocale);
const t = words[lang];
const home = pathOf({ kind: "home" }, lang);
---

<!-- the home page's hero, smaller: the logo leads, back to the home page; the
     breadcrumbs, then what and where, then the two actions, all centred -->
<section aria-labelledby="page-title" class="pt-4 pb-14 sm:pb-20">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-6 px-4 text-center">
    <a href={home} aria-label={`${business.brand}, ${t.home.toLowerCase()}`}>
      <Logo className="w-32 sm:w-36" />
    </a>
    <nav aria-label={t.breadcrumbs}>
      <ol class="flex items-center gap-1 text-fg-muted">
        <li>
          <a href={home} class="font-semibold text-primary">
            {t.home}
          </a>
        </li>
        <li aria-hidden="true">
          <ChevronRight size={16} />
        </li>
        <li aria-current="page">{crumb}</li>
      </ol>
    </nav>
    <h1
      id="page-title"
      class="max-w-3xl font-display text-4xl leading-tight font-bold tracking-wide uppercase sm:text-5xl"
    >
      {heading}
    </h1>
    <p class="max-w-2xl text-xl text-fg-muted">{intro}</p>
    <QuoteOrCall href="#quote" />
  </div>
</section>
