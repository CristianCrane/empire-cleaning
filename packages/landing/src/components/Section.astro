---
import { Heading } from "@empire-cleaning/ui";

// one band of the page: a titled, linkable region
interface Props {
  id: string;
  title: string;
  intro?: string;
  tone?: "plain" | "raised";
}

const { id, title, intro, tone = "plain" } = Astro.props;
const headingId = `${id}-title`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[
    "scroll-mt-4 py-14 sm:py-20",
    tone === "raised" && "border-y border-border bg-surface",
  ]}
>
  <div class="mx-auto flex max-w-5xl flex-col gap-8 px-4">
    <div class="flex max-w-2xl flex-col gap-3">
      <Heading level={2} id={headingId}>{title}</Heading>
      {intro && <p class="text-lg text-fg-muted">{intro}</p>}
    </div>
    <slot />
  </div>
</section>
