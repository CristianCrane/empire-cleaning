---
import { Heading } from "@empire-cleaning/ui";

// one band of the page: a titled, linkable region
interface Props {
  id: string;
  title: string;
  intro?: string;
  tone?: "plain" | "raised";
  // the title is always centred, and the intro on a phone; "center" puts the
  // intro and everything under it in one column down the middle at every
  // width, e.g. a form
  align?: "start" | "center";
}

const { id, title, intro, tone = "plain", align = "start" } = Astro.props;
const headingId = `${id}-title`;
---

<!-- two plain bands in a row read as one, so the second drops its top
     padding: the space between them stays one band's padding, as everywhere -->
<section
  id={id}
  aria-labelledby={headingId}
  data-tone={tone}
  class:list={[
    "scroll-mt-4 py-14 sm:py-20",
    tone === "raised" && "border-y border-border bg-surface",
    tone === "plain" && "[[data-tone=plain]+&]:pt-0",
  ]}
>
  <div
    class:list={[
      "mx-auto flex flex-col gap-8 px-4",
      align === "center" ? "max-w-2xl" : "max-w-5xl",
    ]}
  >
    <div
      class:list={[
        "flex flex-col gap-3",
        align === "center" && "items-center text-center",
      ]}
    >
      {/* every title is centred; the intro too on a phone, or always with "center" */}
      <Heading level={2} id={headingId} className="text-center">{title}</Heading>
      {intro && <p class="max-w-2xl text-center text-lg text-fg-muted sm:text-left">{intro}</p>}
    </div>
    <slot />
  </div>
</section>
