---
import { Heading } from "@empire-cleaning/ui";

// one band of the page: a titled, linkable region
interface Props {
  id: string;
  title: string;
  intro?: string;
  tone?: "plain" | "raised";
  // the title is always centred; "center" puts the intro and everything under
  // it in one column down the middle too, e.g. a form
  align?: "start" | "center";
}

const { id, title, intro, tone = "plain", align = "start" } = Astro.props;
const headingId = `${id}-title`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[
    "scroll-mt-4 py-14 sm:py-20",
    tone === "raised" && "border-y border-border bg-surface",
  ]}
>
  <div
    class:list={[
      "mx-auto flex flex-col gap-8 px-4",
      align === "center" ? "max-w-2xl" : "max-w-5xl",
    ]}
  >
    <div
      class:list={[
        "flex flex-col gap-3",
        align === "center" && "items-center text-center",
      ]}
    >
      {/* every title is centred; only "center" centres the intro too */}
      <Heading level={2} id={headingId} className="text-center">{title}</Heading>
      {intro && <p class="max-w-2xl text-lg text-fg-muted">{intro}</p>}
    </div>
    <slot />
  </div>
</section>
