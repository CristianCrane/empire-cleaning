---
import { Heading } from "@empire-cleaning/ui";
import { raisedBand } from "../band.ts";

// one band of the page: a titled, linkable region
interface Props {
  id: string;
  title: string;
  intro?: string;
  // the title and intro are always centred; "center" puts everything under
  // them in one narrower column down the middle too, e.g. a form
  align?: "start" | "center";
}

const { id, title, intro, align = "start" } = Astro.props;
const headingId = `${id}-title`;
---

<!-- plain or raised by its place on the page (band.ts) -->
<section
  id={id}
  aria-labelledby={headingId}
  class:list={["scroll-mt-4 py-14 sm:py-20", raisedBand]}
>
  <div
    class:list={[
      "mx-auto flex flex-col gap-8 px-4",
      align === "center" ? "max-w-2xl" : "max-w-5xl",
    ]}
  >
    <div
      class:list={[
        "flex flex-col gap-3",
        align === "center" && "items-center text-center",
      ]}
    >
      {/* every title and intro is centred */}
      <Heading level={2} id={headingId} className="text-center">{title}</Heading>
      {intro && <p class="mx-auto max-w-2xl text-center text-lg text-fg-muted">{intro}</p>}
    </div>
    <slot />
  </div>
</section>
