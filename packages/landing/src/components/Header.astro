---
import { buttonStyles } from "@empire-cleaning/ui";
import { languageNames, languageOf } from "@empire-cleaning/models";
import { ThemeToggleIn } from "./InLanguage.tsx";
import { Languages, LogIn } from "lucide-react";
import { appUrl } from "../app-url.ts";
import { pathOf, type Page } from "../routes.ts";
import { words } from "../words.ts";

// the page it heads, whose twin in the other language the switch leads to;
// none for the 404, whose switch leads to the other language's home page
interface Props {
  page: Page | null;
}
const { page } = Astro.props;
const lang = languageOf(Astro.currentLocale);
const other = lang === "en" ? "es" : "en";
const t = words[lang];
---

<!-- no bar: three quiet actions in the hero's top right corner. The logo
     leads the hero (UX pass, #96); Request a Quote and the phone number are
     the hero's, just below. The language switch goes to this page in the
     other language, never by itself (ADR-0025). Sign in is here on every
     screen, for Clients who don't remember the app's address; it says the
     page's language, which the app's screens before sign-in follow -->
<header>
  <div class="mx-auto flex max-w-5xl items-center justify-end gap-2 px-4 py-3">
    <a
      href={pathOf(page ?? { kind: "home" }, other)}
      hreflang={other}
      lang={other}
      data-language-switch
      class={buttonStyles({ variant: "quiet", className: "px-2 sm:px-4" })}
    >
      <Languages aria-hidden size={18} />
      {languageNames[other]}
    </a>
    <a
      href={`${appUrl}/?lang=${lang}`}
      class={buttonStyles({ variant: "quiet", className: "px-2 sm:px-4" })}
    >
      <LogIn aria-hidden size={18} />
      {t.signIn}
    </a>
    {/* hydrates once the browser is idle */}
    <ThemeToggleIn client:idle lang={lang} />
  </div>
</header>
