---
import { languageOf } from "@empire-cleaning/models";
import { Logo } from "@empire-cleaning/ui";
import {
  siFacebook,
  siGoogle,
  siInstagram,
  siYelp,
  type SimpleIcon,
} from "simple-icons";
import { areas } from "../areas/index.ts";
import { business, businessWords } from "../business.ts";
import { pathOf } from "../routes.ts";
import { words } from "../words.ts";

// each of the business's pages elsewhere (business.social) has its
// network's mark, shown in one colour (#223): a page added without its mark
// fails the typecheck
const marks: Record<keyof typeof business.social, SimpleIcon> = {
  facebook: siFacebook,
  instagram: siInstagram,
  yelp: siYelp,
  google: siGoogle,
};

// the business's pages elsewhere, each with its mark
const social = Object.entries(business.social).map(([network, page]) => ({
  ...page,
  mark: marks[network as keyof typeof marks],
}));
const lang = languageOf(Astro.currentLocale);
const t = words[lang].footer;
---

<footer class="flex flex-col gap-8 py-10">
  <!-- centred on a phone, the areas on top; from a tablet three columns, the
     areas left, the logo in the middle and the details right, their middles
     level -->
  <div class="mx-auto flex w-full max-w-5xl flex-col items-center gap-8 px-4 text-center sm:grid sm:grid-cols-3 sm:gap-4">
    <!-- every area's page, from every page (#176) -->
    <nav aria-label={t.areas} class="sm:justify-self-start">
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 sm:flex-col sm:items-start">
        {areas.map((area) => (
          <li>
            <a
              href={pathOf({ kind: "area", area: area.en.key }, lang)}
              class="font-semibold text-primary"
            >
              {area[lang].name}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <Logo className="w-36 sm:justify-self-center" />
    <div class="flex flex-col items-center gap-1 text-fg-muted sm:items-end sm:text-right">
      <a href={business.phone.href} class="font-semibold text-fg">
        {business.phone.display}
      </a>
      <span>{business.area[lang]}</span>
      <span>{businessWords[lang].hours}</span>
      {/* said in Spanish on an English page */}
      {t.spanish && <span lang="es">{t.spanish}</span>}
      <ul aria-label={t.online} class="my-2 flex gap-4">
        {social.map(({ name, href, mark }) => (
          <li>
            <a
              href={href}
              target="_blank"
              rel="noopener"
              aria-label={t.on(name)}
              class="flex size-8 items-center justify-center text-fg-muted hover:text-primary"
            >
              <svg
                aria-hidden
                viewBox="0 0 24 24"
                class="size-5"
                fill="currentColor"
              >
                <path d={mark.path} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <p class="px-4 text-center text-fg-muted">
    &copy; {new Date().getFullYear()} {business.name}
  </p>
</footer>
