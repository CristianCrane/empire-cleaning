---
import { Logo } from "@empire-cleaning/ui";
import { business } from "../business.ts";
---

<footer class="py-10">
  <!-- centred on a phone; the logo left and the details right from there -->
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 text-center sm:flex-row sm:items-end sm:justify-between sm:text-right">
    <Logo className="w-36" />
    <div class="flex flex-col items-center gap-1 text-fg-muted sm:items-end">
      <a href={business.phone.href} class="font-semibold text-fg">{business.phone.display}</a>
      <span>{business.area}</span>
      <span>&copy; {new Date().getFullYear()} {business.name}</span>
    </div>
  </div>
</footer>
